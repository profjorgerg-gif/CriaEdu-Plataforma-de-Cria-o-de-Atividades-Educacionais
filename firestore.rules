rules_version = '2';

// CriaEdu: cada professor só lê e grava o próprio espaço (usuarios/{uid}/...).
// Cole este conteúdo em Firestore Database > Regras e clique em Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
